NEWS_DATABASE_URL=sqlite+aiosqlite:///./data/news_automation.db
NEWS_SOURCES_FILE=config/sources.yml
NEWS_COLLECTION_ENABLED=true
NEWS_COLLECTION_INTERVAL_MINUTES=15
NEWS_DEDUPLICATION_ENABLED=true
NEWS_DEDUPLICATION_INTERVAL_MINUTES=15
NEWS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NEWS_EMBEDDING_BATCH_SIZE=16
NEWS_DEDUPLICATION_AUTO_THRESHOLD=0.88
NEWS_DEDUPLICATION_REVIEW_THRESHOLD=0.78
NEWS_CREDIBILITY_ENABLED=true
NEWS_CREDIBILITY_INTERVAL_MINUTES=20
NEWS_CREDIBILITY_BATCH_SIZE=10
NEWS_CREDIBILITY_CONFIDENCE_THRESHOLD=0.75
NEWS_TRUST_POLICY_FILE=config/trust.yml
NEWS_CLAIM_EXTRACTION_PROVIDER=heuristic
NEWS_OLLAMA_BASE_URL=http://localhost:11434
NEWS_OLLAMA_MODEL=qwen2.5:7b
NEWS_RESEARCH_ENABLED=true
NEWS_RESEARCH_INTERVAL_MINUTES=25
NEWS_RESEARCH_BATCH_SIZE=10
NEWS_RESEARCH_EXTERNAL_PROVIDER=none
NEWS_RESEARCH_MAX_SOURCES=8
NEWS_SCRIPT_WRITER_ENABLED=true
NEWS_SCRIPT_WRITER_INTERVAL_MINUTES=30
NEWS_SCRIPT_WRITER_BATCH_SIZE=10
NEWS_SCRIPT_WRITER_PROVIDER=extractive
NEWS_SCRIPT_TARGET_SECONDS=60
NEWS_SCRIPT_MINIMUM_RESEARCH_SOURCES=1
NEWS_SCENE_PLANNER_ENABLED=true
NEWS_SCENE_PLANNER_INTERVAL_MINUTES=30
NEWS_SCENE_PLANNER_BATCH_SIZE=10
NEWS_SCENE_MIN_DURATION_SECONDS=3
NEWS_TTS_ENABLED=true
NEWS_TTS_INTERVAL_MINUTES=30
NEWS_TTS_BATCH_SIZE=5
NEWS_TTS_PROVIDER=piper
NEWS_TTS_PIPER_EXECUTABLE=piper
NEWS_TTS_PIPER_VOICE_MODEL=models/piper/en_US-lessac-medium.onnx
NEWS_TTS_CHUNK_MAX_CHARACTERS=450
NEWS_TTS_OUTPUT_DIR=assets/generated/audio
NEWS_TTS_GENERATE_MP3=false
NEWS_TTS_FFMPEG_EXECUTABLE=ffmpeg
NEWS_VIDEO_ENABLED=true
NEWS_VIDEO_INTERVAL_MINUTES=30
NEWS_VIDEO_BATCH_SIZE=3
NEWS_VIDEO_FFMPEG_EXECUTABLE=ffmpeg
NEWS_VIDEO_OUTPUT_DIR=assets/generated/video
NEWS_VIDEO_WIDTH=1920
NEWS_VIDEO_HEIGHT=1080
NEWS_VIDEO_FPS=30
NEWS_VIDEO_BACKGROUND_COLOR=0x0F172A
NEWS_APPROVAL_MIN_VIDEO_BYTES=1024
NEWS_PUBLISHING_ENABLED=true
NEWS_PUBLISHING_INTERVAL_MINUTES=60
NEWS_PUBLISHING_BATCH_SIZE=5
NEWS_PUBLISHING_DEFAULT_PLATFORM=local
NEWS_PUBLISHING_OUTPUT_DIR=assets/published
# Optional YouTube Data API upload. Keep these values in .env or a secret manager only.
NEWS_PUBLISHING_YOUTUBE_CLIENT_ID=
NEWS_PUBLISHING_YOUTUBE_CLIENT_SECRET=
NEWS_PUBLISHING_YOUTUBE_REFRESH_TOKEN=
NEWS_PUBLISHING_YOUTUBE_PRIVACY_STATUS=private
NEWS_PUBLISHING_YOUTUBE_CATEGORY_ID=25
NEWS_PUBLISHING_YOUTUBE_DEFAULT_LANGUAGE=en
NEWS_PUBLISHING_YOUTUBE_MADE_FOR_KIDS=false
NEWS_REQUEST_TIMEOUT_SECONDS=20
NEWS_MAX_ARTICLES_PER_SOURCE=20
NEWS_USER_AGENT=NewsAutomationPlatform/0.1 (contact: replace-me@example.com)
NEWS_LOG_LEVEL=INFO
